# PlatformIO (ESP32-прошивка)
.pio/
.vscode/
*.bak

# PC-симулятор (pc-sim) — всё это тяжёлое и легко восстанавливается
# по инструкциям в pc-sim/README.md (git clone lvgl, bootstrap vcpkg)
pc-sim/build/
pc-sim/lib/lvgl/
pc-sim/tools/vcpkg/
pc-sim/vcpkg_installed/

# Временные логи, которые иногда создаются при отладке сборки
*_log.txt
build_log.txt

# Дампы сниффера ИОН (tools/ion-sniffer) — сырой обмен, не для коммита.
tools/ion-sniffer/ion_sniff_*.log

# Дамп прошивки ЭБУ (TRS251) — личный референс пользователя для
# reverse engineering K-Line, не часть проекта, не для коммита.
*.bin

# Python кэш
__pycache__/
*.pyc

# Генерируется при сборке из прошивки + firmware_cal.ini
# (tools/fw_cal/gen_fw_cal.py) — в коммит не нужен.
include/firmware_cal.h
